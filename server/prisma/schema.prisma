generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  GUARDIAN
}

enum EducationLevel {
  SECONDARY
  HIGH_SCHOOL
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

enum PaymentStatus {
  PENDING
  PAID
  REJECTED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(254)
  phone        String?   @db.VarChar(30)
  passwordHash String
  role         UserRole  @default(STUDENT)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  guardianLinks  StudentGuardian[] @relation("Guardian")
  studentLinks   StudentGuardian[] @relation("Student")
  bookings       Booking[]
  payments       Payment[]

  @@index([role, isActive])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(80)
  slug        String   @unique @db.VarChar(80)
  description String?  @db.VarChar(1000)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacherSpecialties TeacherSpecialty[]
  schedules          Schedule[]
  plans              Plan[]
  contactRequests    ContactRequest[]

  @@index([isActive, name])
}

model TeacherProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  biography String?  @db.VarChar(2000)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties  TeacherSpecialty[]
  schedules    Schedule[]

  @@index([isActive])
}

model TeacherSpecialty {
  teacherId String
  subjectId String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([teacherId, subjectId])
  @@index([subjectId])
}

model StudentProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  educationLevel  EducationLevel
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentGuardian {
  studentId  String
  guardianId String
  createdAt  DateTime @default(now())

  student  User @relation("Student", fields: [studentId], references: [id], onDelete: Cascade)
  guardian User @relation("Guardian", fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
}

model Schedule {
  id        String         @id @default(cuid())
  subjectId String
  teacherId String
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int
  status    ScheduleStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacher  TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  bookings Booking[]

  @@index([subjectId, startsAt])
  @@index([teacherId, startsAt])
  @@index([status, startsAt])
}

model Booking {
  id         String        @id @default(cuid())
  studentId  String
  scheduleId String
  status     BookingStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  student  User     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)

  @@unique([studentId, scheduleId])
  @@index([studentId, status, createdAt])
  @@index([scheduleId, status])
}

model Plan {
  id           String   @id @default(cuid())
  subjectId    String?
  name         String   @unique @db.VarChar(120)
  description  String?  @db.VarChar(1000)
  price        Decimal  @db.Decimal(10, 2)
  sessionCount Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([isActive, price])
}

model ContactRequest {
  id        String        @id @default(cuid())
  name      String        @db.VarChar(120)
  email     String?       @db.VarChar(254)
  phone     String?       @db.VarChar(30)
  message   String        @db.VarChar(3000)
  subjectId String?
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([subjectId])
}

model Payment {
  id                 String        @id @default(cuid())
  studentId          String
  planId             String
  amount             Decimal       @db.Decimal(10, 2)
  externalReference  String?       @unique @db.VarChar(200)
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)
  plan    Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([studentId, status, createdAt])
  @@index([planId, createdAt])
}
